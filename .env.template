# Copy to repo root as `.env` before Docker Compose interpolation.
#
#   cp .env.template .env

# Same GPU host as StreamVLN. Stretch3 clients connect to this LAN address.
ZENOH_ROUTER_HOST=192.168.0.246
ZENOH_ROUTER_PORT=7447
# Containers on the 4060ti use host networking and reach the router on loopback.
ZENOH_HOST_CLIENT_ENDPOINT=127.0.0.1:7447

# Official RoboPoint checkpoint used by this repo's stretch3 branch.
MODEL_PATH=wentao-yuan/robopoint-v1-vicuna-v1.5-13b

# D435i topics from stretch_launch d435i_basic.launch.py (name/namespace "camera").
# StreamVLN uses /camera_top/... instead.
CAMERA_IMAGE_TOPIC=/camera/camera/color/image_raw/compressed
DEPTH_IMAGE_TOPIC=/camera/camera/aligned_depth_to_color/image_raw
ODOM_TOPIC=/stretch3/odom
CMD_VEL_TOPIC=/stretch/cmd_vel
