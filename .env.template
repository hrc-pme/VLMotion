# Copy to repo root as `.env` before Docker Compose interpolation.
#
#   cp .env.template .env

# GPU host LAN IP — Stretch3 clients connect here (not the robot's IP).
# Set to this machine's address: ip -4 route get 1.1.1.1 | awk '/src/ {print $NF}'
# StreamVLN / 4060 Ti lab example: 192.168.0.246
ZENOH_ROUTER_HOST=192.168.0.246
ZENOH_ROUTER_PORT=7447
# Containers on the 4060ti use host networking and reach the router on loopback.
ZENOH_HOST_CLIENT_ENDPOINT=127.0.0.1:7447

# Local PME033541/vla13 checkpoint (host: ./models/vla13).
# vlmotion auto-downloads if missing (see docker/scripts/ensure_vlmotion_model.sh).
# Manual: hf download PME033541/vla13 --local-dir models/vla13 --exclude "runs/*"
MODEL_PATH=/workspace/models/vla13
# VLMOTION_HF_MODEL_ID=PME033541/vla13
# VLMOTION_GPU_PROFILE is set by docker/5060.compose.yaml or 4060ti.compose.yaml (vlmotion service).
# Do not put it in .env — 4060ti must stay on GPU 4-bit; only 5060 uses the CPU fp16 path.

# Camera names are fixed. The GUI selects one; do not remap at launch.
# top camera     = current D415  /camera_top/camera_top/...
# head camera    = D435i         /head_camera/head_camera/...
# gripper camera = D405          /gripper_camera/gripper_camera/...
ODOM_TOPIC=/stretch3/odom
CMD_VEL_TOPIC=/stretch/cmd_vel
